<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.progettoispw.controller.Graphic.SearchResultsGraphicController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Risultati della Ricerca" />

    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" prefWidth="200.0" text="Nome Carta" />
            <TableColumn fx:id="colPrezzo" prefWidth="100.0" text="Prezzo (€)" />
            <TableColumn fx:id="colGradazione" prefWidth="150.0" text="Gradazione" />
            <TableColumn fx:id="colVenditore" prefWidth="150.0" text="Venditore" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="20.0">
        <children>
            <Button mnemonicParsing="false" text="Torna alla Ricerca" onAction="#onBackClick" />
            <Button fx:id="btnAddToCart" mnemonicParsing="false" text="Aggiungi al Carrello" onAction="#onAddToCartClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" />
        </children>
    </HBox>


</VBox>