<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="20"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.progettoispw.controller.graphic.NotificationsGraphicController"
      style="-fx-background-color: #f4f7f6; -fx-padding: 30;">

    <HBox alignment="CENTER_LEFT" maxWidth="700">
        <Button text="← Torna alla Home" onAction="#onBackClick"
                style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 0;"/>

        <Region HBox.hgrow="ALWAYS" />



        <Button text="Logout 🚪" onAction="#onLogoutClick"
                style="-fx-background-color: white; -fx-border-color: #e74c3c; -fx-text-fill: #e74c3c; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 6px 15px; -fx-cursor: hand;"/>
    </HBox>

    <VBox maxWidth="700" VBox.vgrow="ALWAYS" spacing="20"
          style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <VBox spacing="5">
            <Label text="Centro Notifiche 🔔"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Aggiornamenti dai venditori che segui"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <Separator style="-fx-padding: 5 0 5 0;" />

        <ListView fx:id="notificationsList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-control-inner-background: white; -fx-font-size: 14px;">
            <placeholder>
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Tutto tranquillo qui!"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;"/>

                    <Label text="Non hai ancora ricevuto nessuna notifica."
                           style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;"/>
                </VBox>
            </placeholder>
        </ListView>

    </VBox>

</VBox>