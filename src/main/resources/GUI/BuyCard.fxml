<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.progettoispw.controller.graphic.BuyCardsGraphicController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Completa il tuo Acquisto" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <HBox spacing="40.0" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

        <VBox spacing="20.0" HBox.hgrow="ALWAYS" maxWidth="500.0">

            <Label text="1. Dati di Spedizione" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
            <GridPane vgap="15.0" hgap="10.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                </columnConstraints>

                <Label text="Nome e Cognome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNome" promptText="Es. Mario Rossi" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Indirizzo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIndirizzo" promptText="Es. Via Roma, 10" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Città e CAP:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <TextField fx:id="txtCitta" promptText="Città" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtCap" promptText="CAP" prefWidth="80.0"/>
                </HBox>
            </GridPane>

            <Separator />

            <Label text="2. Metodo di Pagamento" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
            <GridPane vgap="15.0" hgap="10.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                </columnConstraints>

                <Label text="Numero Carta:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNumeroCarta" promptText="0000 1111 2222 3333" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Scadenza:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="txtScadenza" promptText="MM/AA" prefWidth="80.0"/>
                    <Label text="CVV:">
                        <padding><Insets left="15.0"/></padding>
                    </Label>
                    <TextField fx:id="txtCvv" promptText="123" prefWidth="60.0"/>
                </HBox>
            </GridPane>
        </VBox>

        <VBox spacing="15.0" minWidth="280.0" maxWidth="300.0" style="-fx-background-color: #F8F9FA; -fx-padding: 25; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8;">
            <Label text="Riepilogo Ordine" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox alignment="CENTER_LEFT">
                <Label text="Articoli nel carrello:"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNumeroArticoli" text="0" style="-fx-font-weight: bold;"/>
            </HBox>

            <Separator />

            <HBox alignment="CENTER_LEFT">
                <Label text="Totale:" style="-fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotale" text="0.00 €" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS" prefHeight="20.0"/>

            <Button fx:id="btnConferma" text="Conferma Acquisto"  style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;" onAction="#onConfirmClick"/>

            <Button fx:id="btnAnnulla" text="Torna al Carrello" style="-fx-background-color: transparent; -fx-border-color: #F44336; -fx-text-fill: #F44336; -fx-font-size: 14px; -fx-padding: 10; -fx-border-radius: 5; -fx-cursor: hand;" onAction="#onBackClick"/>
        </VBox>

    </HBox>
</VBox>