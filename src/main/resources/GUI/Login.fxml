<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.example.progettoispw.controller.graphic.LoginGraphicController"
      alignment="CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@light-theme.css"
      style="-fx-background-color: #f4f7f6;"> <Region VBox.vgrow="ALWAYS" />

    <VBox styleClass="login-card" maxWidth="400" spacing="25" alignment="CENTER"
          style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Bentornato!" styleClass="page-title"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Inserisci le tue credenziali per accedere"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <VBox spacing="15" maxWidth="Infinity" alignment="CENTER_LEFT">

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="Username" styleClass="form-label"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <TextField fx:id="usernameField" promptText="Es. MarioRossi99" styleClass="modern-input"
                           style="-fx-padding: 10px 12px; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #ced4da; -fx-background-color: #fdfdfd;"/>
            </VBox>

            <VBox spacing="5" maxWidth="Infinity">
                <Label text="Password" styleClass="form-label"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="modern-input"
                               style="-fx-padding: 10px 12px; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #ced4da; -fx-background-color: #fdfdfd;"/>
            </VBox>

        </VBox>

        <Region prefHeight="5" />

        <Button text="Accedi" onAction="#startLogin" styleClass="primary-button" maxWidth="Infinity"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 6px; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10px 0 0 0;">
            <Label text="Non hai un account?" styleClass="text-muted"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
            <Hyperlink text="Registrati ora" onAction="#goToRegistration" styleClass="link-text"
                       style="-fx-font-size: 13px; -fx-text-fill: #2980b9; -fx-font-weight: bold; -fx-border-color: transparent; -fx-padding: 0;"/>
        </HBox>

    </VBox>

    <Region VBox.vgrow="ALWAYS" />

</VBox>