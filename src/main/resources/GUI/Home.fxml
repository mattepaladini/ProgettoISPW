<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="40.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.progettoispw.Controller.Graphic.HomeGraphicController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="10.0">
        <Label text="Card Market Home" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        <Label text="Scegli cosa vuoi fare oggi" textFill="#7f8c8d">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
    </VBox>

    <GridPane alignment="CENTER" hgap="30.0" vgap="30.0">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="150.0" />
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="150.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="100.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="100.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Button text="🔍 CERCA CARTE" onAction="#onSearchClick"
                prefHeight="100.0" prefWidth="200.0"
                style="-fx-font-size: 16px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"
                GridPane.columnIndex="0" GridPane.rowIndex="0" />

        <Button  fx:id="btnVendi" text="💰 VENDI CARTE" onAction="#onSellPageClicked"
                prefHeight="100.0" prefWidth="200.0"
                style="-fx-font-size: 16px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"
                GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Button text="👤 IL MIO PROFILO" onAction="#onProfileClick"
                prefHeight="100.0" prefWidth="200.0"
                style="-fx-font-size: 16px; -fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"
                GridPane.columnIndex="0" GridPane.rowIndex="1" />

        <Button fx:id="btnCompra" text="🤝 COMPRA CARTE" onAction="#onBuyCards"
                prefHeight="100.0" prefWidth="200.0"
                style="-fx-font-size: 16px; -fx-background-color: #8e44ad; -fx-text-fill: white; -fx-cursor: hand;"
                GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Button fx:id="btnCarrello" text="🛒 CARRELLO" onAction="#onCartClick"
                prefHeight="100.0" prefWidth="200.0"
                style="-fx-font-size: 16px; -fx-background-color: #8e44ad; -fx-text-fill: white; -fx-cursor: hand;"
                GridPane.columnIndex="2" GridPane.rowIndex="0" />

    </GridPane>

</VBox>