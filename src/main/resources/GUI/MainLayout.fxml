<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:id="borderPane"
            fx:controller="com.example.progettoispw.controller.Graphic.MainLayoutController">

    <left>
        <VBox fx:id="sideBar" spacing="10.0" style="-fx-background-color: #2c3e50;" prefWidth="200.0">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="MENU" textFill="WHITE">
                <font><Font name="System Bold" size="18"/></font>
            </Label>

            <Button fx:id="btnHome" text="Home / Dashboard"  onAction="#showHome" maxWidth="Infinity" />
            <Button fx:id="btnSearch" text ="Cerca" onAction="#goToSearch" maxWidth="-Infinity" />
            <Button fx:id="btnBuy" text="Compra Carte"  maxWidth="Infinity" />
            <Button fx:id ="btnSell" text="Vendi Carte" onAction="#showSell" maxWidth="Infinity" />
            <Button fx:id="btnProfile" text="Il mio Profilo" onAction="#showProfile" maxWidth="Infinity" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button text="Logout" onAction="#doLogout" maxWidth="Infinity" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="centerPane" style="-fx-background-color: #ecf0f1;">
        </StackPane>
    </center>

</BorderPane>