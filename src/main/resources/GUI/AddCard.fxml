<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.progettoispw.controller.Graphic.AddCardGraphicController"
      alignment="CENTER" spacing="20" style="-fx-padding: 30;">

    <Label text="Aggiungi Nuova Carta" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane vgap="15" hgap="10" maxWidth="500" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
        </columnConstraints>

        <Label text="Nome Carta:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Es: Drago Bianco Occhi Blu" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Prezzo (€):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" promptText="Es: 15.50" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Condizione:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="gradeComboBox" promptText="Seleziona Condizione" prefWidth="300"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Tipo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeComboBox" promptText="Seleziona Condizione" prefWidth="300"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Attributo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="attributeComboBox" promptText="Seleziona Condizione" prefWidth="300"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Livello:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="levelField" promptText="Es: 8" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Annulla" onAction="#onCancel" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button text="Salva Carta" onAction="#onSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>